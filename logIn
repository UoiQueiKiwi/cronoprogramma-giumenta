<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accesso OAuth con Netlify</title>
    <style>
        body { font-family: Arial, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f4f7f6; margin: 0; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center; max-width: 400px; width: 100%; }
        button { display: block; width: 100%; padding: 12px; margin: 10px 0; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; font-weight: bold; }
        .btn-google { background-color: #4285F4; color: white; }
        .btn-github { background-color: #333; color: white; }
        .btn-logout { background-color: #e74c3c; color: white; }
        .hidden { display: none; }
    </style>
    
    
    </script>
</head>
<body>

    <div class="card">
        <!-- Schermata di Login (visibile se l'utente non è loggato) -->
        <div id="login-view">
            <h2>Accedi al tuo account</h2>
            <p>Scegli un metodo di autenticazione rapido:</p>
            <button class="btn-google" onclick="loginCon('google')">Accedi con Google</button>
            <button class="btn-github" onclick="loginCon('github')">Accedi con GitHub</button>
        </div>

        <!-- Schermata dell'Area Riservata (visibile se l'utente è loggato) -->
        <div id="user-view" class="hidden">
            <h2>Benvenuto!</h2>
            <p>Sei loggato come: <strong id="user-email"></strong></p>
            <button class="btn-logout" onclick="eseguiLogout()">Disconnetti</button>
        </div>
    </div>

    <script>
        // Estrai le funzioni necessarie dall'oggetto globale caricato dalla CDN
        const { oauthLogin, handleAuthCallback, getUser, logout } = window.netlifyIdentity;

        // Esegui i controlli non appena la pagina HTML è pronta
        document.addEventListener('DOMContentLoaded', async () => {
            
            // ⚠️ FONDAMENTALE: Intercetta i token di ritorno da Google/GitHub nell'URL
            try {
                const loginResult = await handleAuthCallback();
                if (loginResult) {
                    console.log("Login OAuth completato con successo:", loginResult);
                }
            } catch (err) {
                console.error("Errore durante il callback di autenticazione:", err);
            }

            // Controlla lo stato dell'utente e aggiorna l'interfaccia grafica
            aggiornaInterfaccia();
        });

        // Funzione per avviare il login OAuth con il provider scelto
        function loginCon(provider) {
            // provider può essere 'google', 'github', 'gitlab', o 'bitbucket'
            oauthLogin(provider); 
        }

        // Funzione per mostrare la schermata corretta in base alla sessione dell'utente
        function aggiornaInterfaccia() {
            const utente = getUser();
            const loginView = document.getElementById('login-view');
            const userView = document.getElementById('user-view');
            const userEmailSpan = document.getElementById('user-email');

            if (utente) {
                // Utente loggato
                loginView.classList.add('hidden');
                userView.classList.remove('hidden');
                userEmailSpan.textContent = utente.email;
            } else {
                // Utente non loggato
                loginView.classList.remove('hidden');
                userView.classList.add('hidden');
            }
        }

        // Funzione per disconnettere l'utente
        async function eseguiLogout() {
            await logout();
            // Ricarica la pagina per azzerare lo stato dell'applicazione
            window.location.reload();
        }
    </script>

</body>
</html>
